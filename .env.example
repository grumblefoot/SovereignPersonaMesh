# Sovereign Persona Mesh (SPM) Environment Configuration

# Server Proxy Config
SPM_HOST=0.0.0.0
SPM_PORT=5050
SPM_HARDWARE_TIER=SOVEREIGN # Options: SOVEREIGN, PERFORMANCE, EXPERIMENTAL

# LLM Backend (Lemonade / llama-server / vLLM)
LLM_BACKEND_URL=http://localhost:13305/v1
LLM_MODEL_NAME=google/gemma-4-26B-A4B-it
LLM_MAX_CONTEXT_TOKENS=32768

# Consolidation Model (For 3 AM Sleep Cycle)
CONSOLIDATION_MODEL_NAME=google/gemma-4-9B-it

# Evennia World State Engine
EVENNIA_API_URL=http://localhost:4005/api/v1
EVENNIA_SECRET_KEY=spm_evennia_secret_key_change_me

# PostgreSQL + pgvector Config
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=litellm_postgres
POSTGRES_USER=spm_user
POSTGRES_PASSWORD=spm_secure_password
POSTGRES_MIN_POOL=2
POSTGRES_MAX_POOL=10

# CPU Offloaded Embeddings (ONNX Runtime)
EMBEDDING_DIMENSION=3584
ONNX_NUM_THREADS=4
