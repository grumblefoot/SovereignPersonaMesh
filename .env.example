# Sovereign Persona Mesh (SPM) Environment Configuration

# Server Proxy Config
SPM_HOST=0.0.0.0
SPM_PORT=5050
SPM_HARDWARE_TIER=SOVEREIGN # Options: SOVEREIGN, PERFORMANCE, EXPERIMENTAL

# LLM backend: any OpenAI-compatible server (Lemonade, LM Studio, llama-server, vLLM).
# May be on another machine: http://192.168.1.20:1234/v1 for LM Studio with "Serve on
# Local Network" on. SPM maps model names across servers (Gemma-4-26B-A4B-it-GGUF matches
# google/gemma-4-26b-a4b-qat), so the name SillyTavern sends need not match exactly.
BACKEND_LLM_URL=http://localhost:13305/v1
BACKEND_API_KEY=
# Default model when a client asks for "spm-sovereign-mesh"
SPM_DEFAULT_MODEL=Gemma-4-26B-A4B-it-GGUF
# Embeddings. Empty = same server as the chat backend. Set it when the chat model runs
# elsewhere but the embedding model stays local. Changing the embedding MODEL starts a new
# embedding space: run scripts/reembed.py to carry existing memories over.
EMBEDDING_URL=
EMBEDDING_MODEL=Qwen3-Embedding-0.6B-GGUF-Q8_0
LLM_MAX_CONTEXT_TOKENS=32768

# Consolidation Model (For 3 AM Sleep Cycle)
CONSOLIDATION_MODEL_NAME=Gemma-4-E4B-it-GGUF

# Evennia World State Engine
EVENNIA_API_URL=http://localhost:4005/api/v1
EVENNIA_SECRET_KEY=change_me_to_random_secret_key

# PostgreSQL + pgvector Config
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=litellm_postgres
POSTGRES_USER=spm_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_MIN_POOL=2
POSTGRES_MAX_POOL=10

