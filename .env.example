# GENERATED FILE — do not edit by hand.
# Regenerate: .venv/bin/python scripts/gen_env_example.py
#   (checks:      .venv/bin/python scripts/gen_env_example.py --check)
#
# Sovereign Persona Mesh (SPM) environment configuration.
# Copy to .env and adjust. Defaults below match what the code uses when the
# variable is unset.

# ── Server ──
SPM_HOST=127.0.0.1
# Address the proxy binds to. Keep loopback unless you deliberately expose it.

SPM_PORT=5050
# Proxy port (SillyTavern connects here).

SPM_ENGINE_HOST=127.0.0.1
# Address the world engine binds to. Keep loopback.

SPM_ENGINE_PORT=4005
# World engine port.


# ── Model backend ──
BACKEND_LLM_URL=http://localhost:13305/v1
# Any OpenAI-compatible server (Lemonade, LM Studio, llama-server, vLLM).

BACKEND_API_KEY=
# API key for BACKEND_LLM_URL (empty = no auth, typical for local).

SPM_HARDWARE_TIER=SOVEREIGN
# Hardware tier: SOVEREIGN, PERFORMANCE or EXPERIMENTAL.

BACKEND_MAX_TOKENS=128000
# Hard cap on completion tokens the backend may receive.

SPM_REASONING_MODE=none
# none (default) | auto | native | prefill. native: the server separates the model's own
# thinking (reasoning field); none: no private block; prefill: the legacy text <think>
# scratchpad with inline GM actions. auto probes the backend: native if it returns a
# reasoning field, else none; a cloud URL resolves to none (thinking costs money).

SPM_REASONING_EFFORT=low
# low | medium | high: how much a native reasoner may think (reasoning_effort).

SPM_REASONING_MAX_TOKENS=3000
# Extra completion tokens reserved for native thinking on top of the reply.

SPM_CONTEXT_WINDOW_OVERRIDE=0
# Empty/0 = use the hardware tier's window; set to pin the context window.

SPM_DEFAULT_MODEL=Gemma-4-26B-A4B-it-GGUF
# Model served when a client asks for "spm-sovereign-mesh".


# ── Embeddings ──
EMBEDDING_PROVIDER=auto
# auto | openai_compat | none | fake  (onnx_local is phase 4 and raises).
# auto resolves to openai_compat for a loopback/LAN base URL and to
# 'none' for a cloud URL: memories never go to a cloud embedder
# implicitly (SPRINT_PLAN decision 5 / PRD SLA-2).

EMBEDDING_URL=
# Empty string means "use BACKEND_LLM_URL" (the chat backend serves
# /v1/embeddings on Lemonade, KoboldCpp --embeddingsmodel, llama-server
# --embedding). A llama.cpp user can point this at a second instance.

EMBEDDING_API_KEY=
# Empty string means "use BACKEND_API_KEY".

EMBEDDING_MODEL=Qwen3-Embedding-0.6B-GGUF-Q8_0
# Calibrated in a 2026-10-05 bake-off of embedding models:
# the FLM/NPU embed-gemma build scored recall@5 0.125 (near-random; paraphrase and
# unrelated text land 0.02 apart), while Qwen3-Embedding-0.6B-GGUF Q8 scored 0.953
# at 6x lower latency and coexists with the chat LLM (embedding slot, GPU).
# Pull it with: lemonade pull Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0

EMBEDDING_DIM=0
# 0 = the model's native dimension (locked on first successful embed).

EMBEDDING_TIMEOUT_S=3
# Per-request timeout (seconds) for the embedding backend.

EMBEDDING_ALLOW_REMOTE=false
# Explicit SLA-2 opt-in: lets `auto` pick a non-local EMBEDDING_URL.

EMBEDDING_MAX_COSINE_DISTANCE=0.35
# Decision 6: the similarity cut is per-model, not the spec's fixed 0.35.
# Calibrated per bake-off (scripts/embed_bakeoff.py); 0.45 fits
# Qwen3-Embedding-0.6B (F1-optimal 0.43-0.447 on the decision-4 corpus).


# ── Database ──
POSTGRES_HOST=localhost
# PostgreSQL + pgvector. docker compose -f config/docker-compose.yml up -d.

POSTGRES_PORT=5432
# Database port.

POSTGRES_DB=spm
# Database name (matches config/docker-compose.yml).

POSTGRES_USER=spm_user
# Database user.

POSTGRES_PASSWORD=spm_secure_password
# Database password (matches config/docker-compose.yml).

SPM_WORLD_DB=1
# World engine persistence: 0 runs the engine memory-only (no pool).

SPM_DB_CONTAINER=
# Name of a local Docker/Podman database container that `spm start` starts and `spm stop` stops, e.g. spm-postgres. Leave empty if you run PostgreSQL yourself.


# ── Behaviour ──
GATED_HISTORY_ENABLED=true
# Gate chat history through the memory pipeline.

SPM_GM_ACTIONS_MODE=auto
# auto | off | move_only | full. "auto" is decision 14's per-backend preset:
# it resolves to "full" for a loopback/LAN BACKEND_LLM_URL and to "off" for a
# cloud URL (paid APIs don't continue the <think> prefill, and the directive
# tokens cost real money there). Invalid values fall back to "full" (see
# _validate_gm_actions_mode) — the safest explicit mode is the pre-feature
# behaviour boundary, so a typo never silently disables world actions.

SPM_GM_ACTIONS_CHANNEL=auto
# auto | inline | separate. Where GM actions come from: inline = tags in the prefill
# scratchpad; separate = a small structured call after the reply. auto = inline only
# in prefill mode.

SPM_PUBLIC_OUTPUT_DEFAULT=400
# ST's Response Length wins; this is the public cap when ST sends none.

SPM_SLEEP_CYCLE_ENABLED=true
# Run the sleep-cycle memory consolidation inside the proxy scheduler (decision 15).

SPM_SLEEP_CYCLE_HOUR=4
# Local hour (0-23) the sleep cycle runs at.

SPM_GM_ACTIONS_MAX_PER_TURN=4
# Max GM actions extracted per turn.

SPM_GM_ACTIONS_MAX_ROOMS=40
# Max GM-created rooms tracked per session.

CONSOLIDATION_MODEL_NAME=Gemma-4-E4B-it-GGUF
# Model used by the sleep-cycle memory consolidation.


# ── Development ──
SPM_ENGINE_URL=
# Override the engine API base URL (a second instance: tests, spikes, packaging).

SPM_CONFIG_PATH=
# Settings file (what the dashboard and spm init saved; overrides .env). Default: config/config.local.json. The tracked config/config.json is read underneath as repo defaults and never written.

SPM_RELOAD=0
# 1 = uvicorn autoreload for proxy development.

SPM_LOG_HEADERS=0
# 1 = log incoming request headers (debugging).
